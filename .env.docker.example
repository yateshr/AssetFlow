# Used by docker-compose.yml. Copy to ".env" and fill in.

# Address of your company's Supabase API, as the BROWSER reaches it
# (not an internal Docker name). Example: https://db.yourcompany.com
PUBLIC_SUPABASE_URL=

# The public "anon" / "publishable" key from your Supabase project.
# Never put the service_role / secret key here.
PUBLIC_SUPABASE_KEY=

# Port the app listens on, on this machine.
ASSETFLOW_PORT=8080
