# Copy this file to `.env` and fill in the values from your own Supabase project:
#   Supabase dashboard -> Project Settings -> API
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" / "publishable" key. Safe to expose in the browser: access is
# enforced by Row Level Security, not by hiding this key.
# NEVER put the service_role / secret key here.
PUBLIC_SUPABASE_KEY=your-publishable-key
